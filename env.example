# Supabase Configuration
# Get these values from your Supabase project settings
# (Project Settings → API in the Supabase dashboard)

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) API key
# This is safe to commit and expose in frontend code
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Only needed if you add Supabase Auth later
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-KEEP-SECRET
