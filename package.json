{
  "name": "scorehub",
  "version": "1.0.0",
  "private": true,
  "description": "ScoreHub — real-time combat sports league management and multi-judge live scoring platform (MMA / BJJ / K1).",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "roster": "node tools/build-roster.mjs",
    "test": "npm --workspace server run test",
    "test:e2e": "npm --workspace server run test:e2e",
    "lint": "npm --workspace client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
